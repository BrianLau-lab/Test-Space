{{!-- OWNER: frontend-customer. Notification inbox.
     Variable from the route: notifications.
     No read/unread badge: no route changes that state, so showing it would be misleading.
     Content is printed with {{ }} (escaped), which is safe and keeps characters readable. --}}

<div class="mb-4">
  <span class="text-uppercase text-muted fw-bold small">Customer Portal</span>
  <h1 class="h3 mb-0">Notifications</h1>
</div>

<section aria-label="Notification list">
  {{#each notifications}}
    <article class="card border-0 shadow-sm mb-3">
      <div class="card-body p-3 p-md-4">
        <h2 class="h6 mb-1 text-break">{{title}}</h2>
        <p class="text-secondary small mb-2">{{formatDate createdAt}}</p>
        <p class="mb-3 text-break">{{content}}</p>
        {{!-- Link to the related parcel. Accepts a full parcel object or just a packageId,
             because the route owner has not frozen which one is passed. --}}
        {{#if parcel}}
          <a class="btn btn-outline-primary d-inline-flex align-items-center" style="min-height: 44px;" href="/my/packages/{{parcel.id}}">
            View parcel {{parcel.trackingNo}}
          </a>
        {{else if packageId}}
          <a class="btn btn-outline-primary d-inline-flex align-items-center" style="min-height: 44px;" href="/my/packages/{{packageId}}">
            View related parcel
          </a>
        {{/if}}
      </div>
    </article>
  {{else}}
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center p-5">
        <h2 class="h5">No notifications yet</h2>
        <p class="text-secondary mb-0">We will message you here when a parcel is ready for pickup.</p>
      </div>
    </div>
  {{/each}}
</section>
